{
  "name": "r3f-motion",
  "version": "1.0.4",
  "description": "A simple and powerful React animation library for @react-three/fiber leveraging motion.dev",
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/es/index.mjs",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "keywords": [
    "react animation",
    "react-three-fiber",
    "framer-motion-3d",
    "react",
    "three",
    "3d",
    "animation",
    "gestures",
    "spring",
    "framer"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/couch4/r3f-motion.git"
  },
  "author": "Jon Couch",
  "license": "MIT",
  "scripts": {
    "lint": "bun eslint src/**/*.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build": "bun clean && tsc -p . && rollup -c",
    "dev": "bun watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf types dist lib",
    "prettier": "prettier ./src/* --write",
    "watch": "concurrently -c blue,red -n tsc,rollup --kill-others \"tsc --watch -p . --preserveWatchOutput\" \"rollup --config --watch --no-watch.clearScreen\"",
    "prepack": "bun run build",
    "postpublish": "git push --tags"
  },
  "dependencies": {
    "@storybook/addon-docs": "^10.2.10",
    "motion": "^12.29.0",
    "react-merge-refs": "^3.0.2"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/test-renderer": "^9.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/react": "^10.2.0",
    "@storybook/react-vite": "^10.2.0",
    "@storybook/test": "^8.6.15",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.2.0",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "rollup": "^4.56.0",
    "rollup-plugin-dts": "^6.3.0",
    "scheduler": "^0.27.0",
    "storybook": "^10.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "gitHead": "b40bbecf29630ba30d49f763642eb3314861f08c"
}
